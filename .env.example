# ---- Primary: Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MAX_RETRIES=2

# ---- Groq fallback, used when Gemini is rate-limited or quota-exhausted ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_ORDER=groq

# ---- Storage ----
DATABASE_URL=sqlite:///./app.db

# ---- Token Encryption & Security ----
SECRET_KEY=change-this-to-a-secure-random-phrase
TOKEN_ENCRYPTION_KEY=

# ---- LinkedIn OAuth & Publishing ----
# Register app at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_API_VERSION=202610

# ---- Google / Gmail OAuth 2.0 (for sending email via Gmail API) ----
# Register at: https://console.cloud.google.com/apis/credentials
# Enable: Gmail API  |  OAuth consent screen — add scope: gmail.send
# Set Authorized redirect URI to: http://localhost:8000/api/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# ---- Application URLs ----
FRONTEND_URL=http://localhost:3000
